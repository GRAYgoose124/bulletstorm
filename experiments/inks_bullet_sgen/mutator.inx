<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Mutator</name>
    <id>mutator</id>
    <param name="selected_ids" type="string" _gui-text="Selected Object IDs">Comma-separated list of selected object IDs</param>
    <param name="mutation_chance" type="float" default="0.1">Chance of mutation</param>

    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu _name="Game Dev"/>
        </effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">mutator.py</command>
    </script>
</inkscape-extension>
